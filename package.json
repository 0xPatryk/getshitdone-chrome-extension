{
  "name": "getshitdone",
  "version": "1.0.0",
  "description": "AI-powered productivity extension that helps you stay on task by intelligently blocking distractions.",
  "license": "MIT",
  "author": "Patryk Stemporowski",
  "scripts": {
    "build": "run-p build:chrome build:firefox",
    "build:chrome": "wxt zip",
    "build:firefox": "wxt -b firefox zip",
    "dev": "bun dev:chrome",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky",
    "typecheck": "tsgo --noEmit",
    "tsgo": "tsgo",
    "postinstall": "wxt prepare",
    "test": "bun test",
    "test:all": "bun test src/lib/tests/**/*.test.{ts,tsx}",
    "test:unit": "bun test \"**/*.unit.test.{ts,tsx}\"",
    "test:integration": "bun test \"**/*.integration.test.{ts,tsx}\"",
    "test:e2e": "bun test \"**/*.e2e.test.{ts,tsx}\"",
    "test:component": "bun test \"**/*.component.test.{ts,tsx}\"",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:verbose": "bun test --verbose",
    "test:browser": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.53",
    "@biomejs/biome": "^1.9.4",
    "@noble/hashes": "^2.0.1",
    "@openpanel/web": "^1.0.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.90.5",
    "@webext-core/messaging": "^2.3.0",
    "ai": "^5.0.80",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "envin": "^1.1.10",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.12",
    "next-themes": "^0.4.6",
    "npm-run-all": "^4.1.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@commitlint/types": "19.8.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native-preview": "7.0.0-dev.20251024.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.0.3",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.1.5",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vitest-browser-react": "^2.0.0",
    "wxt": "^0.20.11"
  }
}
